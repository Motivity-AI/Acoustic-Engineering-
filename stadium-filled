<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="theme-color" content="#0a1528">
<title>🏟️ AURALIS · Stadium Field</title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&family=Inter:wght@400;600;700;800;900&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
:root{
  --bg:#0a1528;--panel:rgba(18,28,48,.94);--card:rgba(38,52,78,.7);
  --line:rgba(34,197,94,.12);--line2:rgba(34,197,94,.45);
  --txt:#e8f5e8;--txt2:#a8c4a8;--txt3:#5a7a5a;
  --green:#22c55e;--green2:#4ade80;--amber:#fbbf24;--blue:#3b82f6;
  --pitch:#16a34a;--line-white:#f0f8f0;--sky:#0a1528;--stand:#1e293b;
  --sh:0 8px 32px rgba(0,0,0,.7);--font:'Cairo','Inter',sans-serif;
}
html[lang="en"]{--font:'Inter','Cairo',sans-serif}
html[lang="en"] body{font-family:var(--font)}
html{height:100%;overflow:hidden;-webkit-text-size-adjust:100%}
body{position:fixed;inset:0;overflow:hidden;background:var(--bg);color:var(--txt);
  font-family:var(--font);font-size:14px;user-select:none;-webkit-user-select:none}
#c{position:fixed;inset:0;width:100%;height:100%;touch-action:none;display:block;cursor:crosshair}
#loader{position:fixed;inset:0;z-index:9999;background:
  radial-gradient(circle at 50% 40%,rgba(34,197,94,.2),transparent 60%),#0a1528;
  display:grid;place-items:center;transition:opacity .6s,visibility .6s}
#loader.off{opacity:0;visibility:hidden}
#loader .box{text-align:center}
#loader .sym{font-size:70px;filter:drop-shadow(0 0 40px rgba(34,197,94,.85));
  animation:pulse 1.6s ease-in-out infinite}
#loader .txt{margin-top:14px;color:var(--txt2);letter-spacing:3.5px;font-size:12px;font-weight:700}
@keyframes pulse{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(1.1);opacity:.7}}
header{position:fixed;top:0;left:0;right:0;min-height:56px;z-index:100;padding:8px 14px;
  padding-top:calc(8px + env(safe-area-inset-top,0));background:var(--panel);
  backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);
  border-bottom:1px solid var(--line);display:flex;align-items:center;gap:9px;
  transition:transform .4s cubic-bezier(.4,0,.2,1)}
header.hide{transform:translateY(-110%)}
.logo{width:38px;height:38px;border-radius:11px;flex-shrink:0;
  background:linear-gradient(135deg,var(--green),var(--amber));display:grid;place-items:center;
  font-size:20px;color:#0a1528;box-shadow:0 4px 16px rgba(34,197,94,.55);
  border:1px solid rgba(34,197,94,.3)}
.title{display:flex;flex-direction:column;gap:1px;min-width:0}
.title .t1{font-size:14px;font-weight:900;letter-spacing:2px;
  background:linear-gradient(135deg,#fff,var(--green));
  -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;
  white-space:nowrap}
.title .t2{font-size:9.5px;color:var(--txt3);letter-spacing:1.2px;
  font-family:'JetBrains Mono',monospace;white-space:nowrap}
.spacer{flex:1}
.langBtn{height:38px;min-width:50px;padding:0 12px;border-radius:11px;
  background:var(--card);border:1px solid var(--line);color:var(--txt);
  font-family:inherit;font-size:12.5px;font-weight:800;cursor:pointer;
  display:flex;align-items:center;justify-content:center;gap:6px;
  transition:all .2s;flex-shrink:0}
.langBtn:hover{border-color:var(--green);color:var(--green)}
.langBtn:active{transform:scale(.95)}
.btn{height:38px;min-width:38px;padding:0 12px;border-radius:11px;background:var(--card);
  border:1px solid var(--line);color:var(--txt);font-family:inherit;font-size:13px;
  font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;
  gap:6px;transition:transform .15s;flex-shrink:0}
.btn:hover{border-color:var(--line2)}
.btn:active{transform:scale(.94)}
.btn.on{background:linear-gradient(135deg,var(--green),var(--amber));color:#0a1528;border-color:transparent}
.hud{position:fixed;top:76px;inset-inline-end:12px;z-index:50;
  display:flex;flex-direction:column;gap:7px;pointer-events:none;transition:opacity .3s}
.hud .stat{background:var(--panel);backdrop-filter:blur(20px);border:1px solid var(--line);
  padding:7px 13px;border-radius:11px;font-family:'JetBrains Mono',monospace;
  font-size:10px;color:var(--txt2);text-align:center;min-width:82px;transition:border-color .3s}
.hud .stat b{color:var(--green);font-weight:700;font-size:13px;display:block;margin-top:2px}
.hud .stat.good b{color:var(--green2)}
.hud .stat.warn b{color:var(--amber)}
.tools{position:fixed;inset-inline-end:12px;bottom:185px;z-index:60;
  display:flex;flex-direction:column;gap:8px;transition:transform .4s,opacity .3s}
.tools.hide{transform:translateX(-160%);opacity:0}
.tool{width:48px;height:48px;border-radius:14px;border:1px solid var(--line);
  background:var(--panel);backdrop-filter:blur(20px);color:var(--txt);
  font-size:20px;cursor:pointer;display:grid;place-items:center;
  box-shadow:var(--sh);transition:all .2s cubic-bezier(.34,1.56,.64,1)}
.tool:hover{border-color:var(--line2);transform:translateY(-2px)}
.tool:active{transform:scale(.92)}
.tool.on{background:linear-gradient(135deg,var(--green),var(--amber));
  border-color:transparent;color:#0a1528;box-shadow:0 8px 24px rgba(34,197,94,.55)}
.info{position:fixed;top:76px;inset-inline-start:12px;z-index:70;width:250px;
  padding:15px;border-radius:16px;background:var(--panel);
  backdrop-filter:blur(24px);border:1px solid var(--line2);box-shadow:var(--sh);
  transform:translateX(calc(-100% - 30px));opacity:0;
  transition:all .35s cubic-bezier(.34,1.56,.64,1);
  pointer-events:none;max-height:calc(100vh - 210px);overflow-y:auto}
.info.on{transform:translateX(0);opacity:1;pointer-events:auto}
.info h4{font-size:13px;font-weight:800;margin-bottom:3px;color:var(--green);
  display:flex;align-items:center;gap:7px}
.info .tag{font-size:9.5px;color:var(--txt3);margin-bottom:11px;
  font-family:'JetBrains Mono',monospace;letter-spacing:.6px;text-transform:uppercase}
.info .row{display:flex;justify-content:space-between;align-items:center;
  padding:5px 0;font-size:11px;border-bottom:1px dashed var(--line)}
.info .row:last-of-type{border:none}
.info .row span:first-child{color:var(--txt3)}
.info .row span:last-child{color:var(--txt);font-weight:700;font-family:'JetBrains Mono',monospace}
.info .slider{margin-top:8px;display:flex;align-items:center;gap:7px}
.info .slider label{font-size:10px;color:var(--txt3);min-width:48px}
.info .slider input{flex:1;-webkit-appearance:none;appearance:none;height:3px;
  border-radius:2px;background:rgba(255,255,255,.12);outline:none}
.info .slider input::-webkit-slider-thumb{-webkit-appearance:none;
  width:14px;height:14px;border-radius:50%;background:var(--green);
  box-shadow:0 0 8px rgba(34,197,94,.7);cursor:pointer}
.info .slider b{font-size:10px;color:var(--green);
  font-family:'JetBrains Mono',monospace;min-width:42px;text-align:end}
.info .numInput{width:64px;background:var(--card);border:1px solid var(--line);
  color:var(--txt);border-radius:6px;padding:3px 6px;font-family:inherit;font-size:11px}
.info .actions{display:flex;gap:6px;margin-top:12px}
.info .actions button{flex:1;padding:9px;border-radius:10px;font-family:inherit;
  font-size:11px;font-weight:700;cursor:pointer;border:1px solid var(--line);
  background:var(--card);color:var(--txt);transition:all .2s}
.info .actions button:hover{background:rgba(255,255,255,.05)}
.info .actions button.del{background:rgba(255,122,156,.15);color:#ff7a9c;
  border-color:rgba(255,122,156,.4)}
.picker{position:fixed;bottom:0;left:0;right:0;z-index:80;padding:10px 12px;
  padding-bottom:calc(10px + env(safe-area-inset-bottom,0));
  background:var(--panel);backdrop-filter:blur(24px);
  border-top:1px solid var(--line);
  transition:transform .4s cubic-bezier(.4,0,.2,1)}
.picker.hide{transform:translateY(110%)}
.cats,.brands{display:flex;gap:6px;margin-bottom:7px;overflow-x:auto;
  scrollbar-width:none;padding-bottom:1px}
.cats::-webkit-scrollbar,.brands::-webkit-scrollbar{display:none}
.cat{padding:7px 14px;border-radius:10px;flex-shrink:0;background:var(--card);
  border:1.5px solid transparent;color:var(--txt2);font-family:inherit;
  font-size:11.5px;font-weight:700;cursor:pointer;transition:all .2s;white-space:nowrap}
.cat.on{background:linear-gradient(135deg,var(--green),var(--amber));color:#0a1528;
  box-shadow:0 4px 12px rgba(34,197,94,.5)}
.brand{padding:6px 12px;border-radius:9px;flex-shrink:0;background:var(--card);
  border:1px solid transparent;color:var(--txt2);font-family:inherit;font-size:11px;
  font-weight:700;cursor:pointer;transition:all .2s;white-space:nowrap}
.brand.on{border-color:var(--green2);color:var(--green2);background:rgba(74,222,128,.12)}
.types{display:grid;grid-template-columns:repeat(auto-fill,minmax(78px,1fr));gap:6px;
  max-height:120px;overflow-y:auto;scrollbar-width:thin;padding:1px}
.types::-webkit-scrollbar{width:4px}
.types::-webkit-scrollbar-thumb{background:var(--line2);border-radius:2px}
.type{padding:8px 4px;border-radius:10px;background:var(--card);
  border:1.5px solid transparent;color:var(--txt2);font-family:inherit;
  font-size:9.5px;font-weight:700;cursor:pointer;transition:all .2s;
  display:flex;flex-direction:column;align-items:center;gap:3px;min-height:58px}
.type:hover{border-color:var(--line2)}
.type:active{transform:scale(.94)}
.type.on{background:linear-gradient(135deg,var(--green),var(--amber));color:#0a1528;
  box-shadow:0 5px 16px rgba(34,197,94,.5)}
.type .em{font-size:20px;line-height:1}
.type .nm{font-size:9px;line-height:1.2;text-align:center}
.toast{position:fixed;bottom:195px;left:50%;transform:translateX(-50%) translateY(20px);
  padding:11px 22px;border-radius:14px;background:var(--panel);
  backdrop-filter:blur(20px);border:1px solid var(--line2);
  font-size:13px;font-weight:700;color:var(--txt);opacity:0;pointer-events:none;
  transition:all .3s;z-index:200;white-space:nowrap;box-shadow:0 12px 40px rgba(0,0,0,.6)}
.toast.on{opacity:1;transform:translateX(-50%) translateY(0)}
.presBtn{position:fixed;bottom:22px;left:50%;transform:translateX(-50%);
  z-index:90;padding:13px 26px;border-radius:30px;
  background:linear-gradient(135deg,var(--green),var(--amber));
  color:#0a1528;font-family:inherit;font-size:13px;font-weight:800;
  border:0;cursor:pointer;display:none;box-shadow:0 12px 40px rgba(34,197,94,.55)}
.presBtn.on{display:block;animation:showB .4s cubic-bezier(.34,1.56,.64,1)}
@keyframes showB{from{transform:translateX(-50%) scale(.5);opacity:0}}
.exitP{position:fixed;top:calc(22px + env(safe-area-inset-top,0));
  inset-inline-end:22px;z-index:100;width:46px;height:46px;border-radius:50%;
  background:rgba(18,28,48,.85);backdrop-filter:blur(20px);
  border:1px solid var(--line);color:var(--txt);font-size:20px;cursor:pointer;
  display:none;place-items:center;transition:all .2s}
.exitP.on{display:grid}
.exitP:active{transform:scale(.9)}
.modal{position:fixed;inset:0;background:rgba(10,20,40,.92);backdrop-filter:blur(10px);
  z-index:1000;display:none;align-items:center;justify-content:center;padding:18px}
.modal.on{display:flex;animation:fadeIn .25s}
@keyframes fadeIn{from{opacity:0}}
.modal-content{background:#0f1f3a;border:1px solid var(--line2);border-radius:20px;
  width:100%;max-width:760px;max-height:88vh;display:flex;flex-direction:column;
  box-shadow:0 24px 80px rgba(0,0,0,.85);overflow:hidden;
  animation:slideUp .35s cubic-bezier(.34,1.56,.64,1)}
@keyframes slideUp{from{transform:translateY(30px);opacity:0}}
.modal-header{padding:16px 20px;border-bottom:1px solid var(--line);display:flex;
  align-items:center;justify-content:space-between;gap:12px;background:rgba(26,42,72,.8)}
.modal-header h3{color:var(--green);font-size:15px;font-weight:800;display:flex;align-items:center;gap:9px}
.modal-body{padding:22px;overflow-y:auto;font-size:13px;line-height:1.65}
.report-section{margin-bottom:20px}
.report-section:last-child{margin-bottom:0}
.report-section h4{color:var(--amber);font-size:14px;margin-bottom:10px;
  border-bottom:1px solid var(--line);padding-bottom:6px;display:flex;align-items:center;gap:8px}
.modal-body .row{display:flex;justify-content:space-between;gap:12px;
  padding:7px 0;font-size:12.5px;border-bottom:1px dashed var(--line)}
.modal-body .row:last-child{border:none}
.modal-body .row span:first-child{color:var(--txt3)}
.modal-body .row span:last-child{font-weight:700;font-family:'JetBrains Mono',monospace}
.report-table{width:100%;border-collapse:collapse;margin-top:10px;
  border-radius:10px;overflow:hidden}
.report-table th,.report-table td{border:1px solid var(--line);
  padding:10px 12px;text-align:start;font-size:12px}
.report-table th{background:rgba(34,197,94,.22);color:#bbf7d0;font-weight:800}
.report-table tr:nth-child(even) td{background:rgba(34,197,94,.03)}
.modal-footer{padding:16px 20px;border-top:1px solid var(--line);
  display:flex;gap:10px;justify-content:flex-end;flex-wrap:wrap}
@media (max-width:600px){
  .title .t2{display:none}
  .langBtn .label{display:none}
  .langBtn{min-width:42px;padding:0 10px}
  .btn{padding:0 9px;font-size:12px}
  .info{width:220px}
  .tool{width:44px;height:44px;font-size:18px}
  .types{grid-template-columns:repeat(auto-fill,minmax(66px,1fr))}
}
@media print{
  body{background:#fff;color:#000;position:static}
  header,.tools,.hud,.picker,.presBtn,.exitP,.info,#c,.toast,#loader{display:none!important}
  .modal{position:absolute;inset:0;background:#fff;padding:0;display:block!important}
  .modal-content{border:none;box-shadow:none;max-height:none;width:100%;color:#000;background:#fff;animation:none}
  .modal-header{background:none;border-bottom:2px solid #000}
  .modal-header h3{color:#000}
  .modal-footer{display:none}
  .modal-body .row span:first-child{color:#555}
  .report-section h4{color:#000}
  .report-table th{background:#eee;color:#000}
  .report-table th,.report-table td{border:1px solid #999}
}
</style>
</head>
<body>

<div id="loader"><div class="box">
  <div class="sym">🏟️</div>
  <div class="txt" id="loaderTxt">LOADING FIELD…</div>
</div></div>

<canvas id="c"></canvas>

<header id="hd">
  <div class="logo">🏟️</div>
  <div class="title">
    <div class="t1">AURALIS</div>
    <div class="t2" id="roomLabel">STADIUM FIELD · PA & COMMENTARY</div>
  </div>
  <div class="spacer"></div>
  <button class="langBtn" id="langBtn" title="Language">
    <span class="flag">🌐</span>
    <span class="label" id="langLabel">EN</span>
  </button>
  <button class="btn" id="reportBtn" data-i18n-title="report_tip">📄</button>
  <button class="btn" id="viewBtn">🎬 3D</button>
  <button class="btn" id="shotBtn" data-i18n-title="shot_tip">📸</button>
  <button class="btn" id="presBtn" data-i18n-title="pres_tip">🎥</button>
</header>

<div class="hud" id="hud">
  <div class="stat" id="statDev"><span data-i18n="hud_devices">Devices</span><b id="hudCount">0</b></div>
  <div class="stat" id="statSpl"><span data-i18n="hud_spl">Max SPL</span><b id="hudSpl">—</b></div>
  <div class="stat" id="statCov"><span data-i18n="hud_coverage">Coverage</span><b id="hudCoverage">—</b></div>
</div>

<div class="tools" id="tools">
  <button class="tool on" id="heatBtn" data-i18n-title="heat_tip">🌡️</button>
  <button class="tool" id="fitBtn" data-i18n-title="fit_tip">🎯</button>
  <button class="tool on" id="gridBtn" data-i18n-title="grid_tip">▦</button>
  <button class="tool" id="saveBtn" data-i18n-title="save_tip">💾</button>
  <button class="tool" id="loadBtn" data-i18n-title="load_tip">📂</button>
  <button class="tool" id="clearBtn" data-i18n-title="clear_tip">🧹</button>
</div>

<input type="file" id="fileInput" style="display:none" accept=".json">

<div class="info" id="info">
  <h4>📦 <span id="infName">—</span></h4>
  <div class="tag" id="infBrand">—</div>
  <div class="row"><span data-i18n="inf_category">Category</span><span id="infType">—</span></div>
  <div class="row"><span data-i18n="inf_power">Power</span><span id="infPower">—</span></div>
  <div class="row"><span data-i18n="inf_height">Height</span><span id="infH">—</span></div>
  <div class="row"><span data-i18n="inf_position">Position</span><span id="infPos">—</span></div>
  <div class="slider" id="powerWrap">
    <label data-i18n="sl_power">Power</label>
    <input type="range" id="powerSlider" min="5" max="3000" step="10" value="20">
    <b id="powerVal">20W</b>
  </div>
  <div class="slider" id="rotWrap">
    <label data-i18n="sl_rotation">Rotation</label>
    <input type="range" id="rotSlider" min="-180" max="180" step="5" value="0">
    <b id="rotVal">0°</b>
  </div>
  <div class="row" style="margin-top:8px">
    <span data-i18n="inf_room_w">Width</span>
    <input type="number" id="roomWInput" class="numInput" min="60" max="300">
  </div>
  <div class="row">
    <span data-i18n="inf_room_d">Depth</span>
    <input type="number" id="roomDInput" class="numInput" min="60" max="300">
  </div>
  <div class="actions">
    <button class="del" id="delBtn" data-i18n="act_delete">🗑️ Delete</button>
  </div>
</div>

<div class="picker" id="picker">
  <div class="cats" id="cats"></div>
  <div class="brands" id="brands"></div>
  <div class="types" id="types"></div>
</div>

<div class="modal" id="reportModal">
  <div class="modal-content">
    <div class="modal-header">
      <h3>📋 <span data-i18n="rep_title">Acoustic Design Report</span></h3>
      <button class="btn" id="closeModalBtn" style="height:32px;min-width:32px;padding:0 8px">✕</button>
    </div>
    <div class="modal-body" id="reportModalBody"></div>
    <div class="modal-footer">
      <button class="btn on" id="printReportBtn" data-i18n="rep_print">🖨️ Print / Save PDF</button>
      <button class="btn" id="closeModalBtn2" data-i18n="rep_close">Close</button>
    </div>
  </div>
</div>

<button class="presBtn" id="presToggle" data-i18n="pres_start">🎥 Start Presentation</button>
<button class="exitP" id="exitPres">✕</button>
<div class="toast" id="toast"></div>

<script src="https://unpkg.com/three@0.128.0/build/three.min.js"></script>
<script>
'use strict';

/* ============ I18N ============ */
const I18N = {
  ar: {
    loader:'جارٍ تحميل الملعب…',
    room_label:'ملعب رياضي · صوت جماهيري وتعليق',
    hud_devices:'الأجهزة', hud_spl:'أقصى SPL', hud_coverage:'التغطية',
    report_tip:'تقرير', shot_tip:'لقطة', pres_tip:'عرض',
    heat_tip:'خريطة حرارية', fit_tip:'ملاءمة', grid_tip:'الشبكة',
    save_tip:'حفظ', load_tip:'فتح', clear_tip:'حذف الكل',
    inf_category:'الفئة', inf_power:'القوة', inf_height:'الارتفاع',
    inf_position:'الموقع', inf_room_w:'العرض', inf_room_d:'الطول',
    sl_power:'القوة', sl_rotation:'الاتجاه', act_delete:'🗑️ حذف',
    rep_title:'التقرير الهندسي الصوتي',
    rep_print:'🖨️ طباعة / حفظ PDF', rep_close:'إغلاق',
    pres_start:'🎥 بدء العرض',
    cat_mainPA:'الـ PA الرئيسي', cat_delay:'أبراج التأخير',
    cat_stands:'المدرجات', cat_field:'أرضية الملعب',
    cat_press:'المنصة الإعلامية', cat_player:'منطقة اللاعبين',
    cat_referee:'طقم التحكيم', cat_paging:'نظام النداء',
    cat_emergency:'نظام الطوارئ', cat_mics:'ميكروفونات',
    cat_amps:'مضخمات', cat_control:'تحكم',
    dev_main_array:'Line Array رئيسي', dev_end_fire:'End-Fire Sub',
    dev_front_fill:'Front Fill', dev_hang_cluster:'Cluster معلق',
    dev_delay_tower:'برج تأخير', dev_delay_pole:'عمود تأخير',
    dev_zone_delay:'Zone Delay',
    dev_grandstand:'سماعة مدرج', dev_under_balcony:'تحت الشرفة',
