/* ============ BUILD ROOM ============ */
function clearGroup(g) {
  while (g.children.length) {
    const c = g.children[0]; g.remove(c);
    c.traverse?.(o => {
      if (o.geometry) o.geometry.dispose();
      if (o.material) {
        if (Array.isArray(o.material)) o.material.forEach(m => m.dispose());
        else o.material.dispose();
      }
    });
  }
}

function buildRoom() {
  clearGroup(roomGrp);

  for (const f of ROOM.features) {
    if (f.type === 'ground') {
      const g = new THREE.Mesh(new THREE.BoxGeometry(f.w, 0.05, f.d), M.concrete());
      g.position.set(f.x, 0.025, f.z); g.receiveShadow = true; roomGrp.add(g);
    }

    /* TRACK (red running track around pitch) */
    if (f.type === 'track') {
      const t = new THREE.Mesh(new THREE.BoxGeometry(f.w, 0.06, f.d), M.track());
      t.position.set(f.x, 0.05, f.z); t.receiveShadow = true; roomGrp.add(t);
    }

    /* PITCH (green football pitch) */
    if (f.type === 'pitch') {
      const p = new THREE.Mesh(new THREE.BoxGeometry(f.w, 0.08, f.d), M.grass());
      p.position.set(f.x, 0.07, f.z); p.receiveShadow = true; roomGrp.add(p);
      /* Mowing stripes */
      for (let i=0;i<10;i++) {
        const stripe = new THREE.Mesh(new THREE.BoxGeometry(f.w - 0.5, 0.005, f.d/10 - 0.3),
          i % 2 === 0 ? M.grassLight() : M.grassDark());
        stripe.position.set(0, 0.115, -f.d/2 + (i+0.5)*(f.d/10));
        roomGrp.add(stripe);
      }
      /* Outer boundary lines */
      const lineW = 0.15;
      const topLine = new THREE.Mesh(new THREE.BoxGeometry(f.w, 0.01, lineW), M.white());
      topLine.position.set(0, 0.12, -f.d/2); roomGrp.add(topLine);
      const botLine = topLine.clone(); botLine.position.z = f.d/2; roomGrp.add(botLine);
      const leftLine = new THREE.Mesh(new THREE.BoxGeometry(lineW, 0.01, f.d), M.white());
      leftLine.position.set(-f.w/2, 0.12, 0); roomGrp.add(leftLine);
      const rightLine = leftLine.clone(); rightLine.position.x = f.w/2; roomGrp.add(rightLine);
      /* Center line */
      const centerLine = new THREE.Mesh(new THREE.BoxGeometry(lineW, 0.01, f.d), M.white());
      centerLine.position.set(0, 0.12, 0); roomGrp.add(centerLine);
      /* Halfway marks */
      const midMark = new THREE.Mesh(new THREE.CylinderGeometry(0.3,0.3,0.01,16), M.white());
      midMark.position.set(0, 0.12, 0); roomGrp.add(midMark);
    }

    /* CENTER CIRCLE */
    if (f.type === 'centerCircle') {
      const torus = new THREE.Mesh(new THREE.TorusGeometry(f.r, 0.06, 8, 48), M.white());
      torus.rotation.x = Math.PI/2; torus.position.set(0, 0.13, 0); roomGrp.add(torus);
    }

    /* PENALTY AREA */
    if (f.type === 'penaltyArea') {
      const w = f.w, d = f.d;
      const lx = f.side === 'west' ? f.x : f.x;
      /* Top line */
      const t = new THREE.Mesh(new THREE.BoxGeometry(w, 0.01, 0.15), M.white());
      t.position.set(f.side === 'west' ? -50 + w/2 : 50 - w/2, 0.13, -d/2); roomGrp.add(t);
      const b = t.clone(); b.position.z = d/2; roomGrp.add(b);
      /* End line */
      const e = new THREE.Mesh(new THREE.BoxGeometry(0.15, 0.01, d), M.white());
      e.position.set(f.side === 'west' ? -50 + w : 50 - w, 0.13, 0); roomGrp.add(e);
    }

    /* GOAL AREA */
    if (f.type === 'goalArea') {
      const w = f.w, d = f.d;
      const t = new THREE.Mesh(new THREE.BoxGeometry(w, 0.01, 0.15), M.white());
      t.position.set(f.side === 'west' ? -50 + w/2 : 50 - w/2, 0.13, -d/2); roomGrp.add(t);
      const b = t.clone(); b.position.z = d/2; roomGrp.add(b);
      const e = new THREE.Mesh(new THREE.BoxGeometry(0.15, 0.01, d), M.white());
      e.position.set(f.side === 'west' ? -50 + w : 50 - w, 0.13, 0); roomGrp.add(e);
    }

    /* CORNER ARC */
    if (f.type === 'cornerArc') {
      const torus = new THREE.Mesh(new THREE.TorusGeometry(1, 0.06, 6, 24, Math.PI/2), M.white());
      torus.rotation.x = Math.PI/2;
      torus.position.set(f.x, 0.13, f.z);
      let rot = 0;
      if (f.side === 'nw') rot = 0;
      else if (f.side === 'ne') rot = Math.PI/2;
      else if (f.side === 'se') rot = Math.PI;
      else rot = -Math.PI/2;
      torus.rotation.z = rot;
      roomGrp.add(torus);
    }

    /* GOAL */
    if (f.type === 'goal') {
      const side = f.side === 'west' ? -1 : 1;
      const gx = f.x;
      /* Posts */
      const post1 = new THREE.Mesh(new THREE.CylinderGeometry(0.12, 0.12, 2.44, 12), M.goalPost());
      post1.position.set(gx, 1.22, -3.66); roomGrp.add(post1);
      const post2 = post1.clone(); post2.position.z = 3.66; roomGrp.add(post2);
      /* Crossbar */
      const bar = new THREE.Mesh(new THREE.CylinderGeometry(0.12, 0.12, 7.32, 12), M.goalPost());
      bar.rotation.x = Math.PI/2; bar.position.set(gx, 2.44, 0); roomGrp.add(bar);
      /* Net (back plane) */
      const net = new THREE.Mesh(new THREE.PlaneGeometry(7.32, 2.44), M.net());
      net.position.set(gx + side*2, 1.22, 0); net.rotation.y = Math.PI/2; roomGrp.add(net);
      /* Side nets */
      for (const s of [-1, 1]) {
        const sideNet = new THREE.Mesh(new THREE.PlaneGeometry(2, 2.44), M.net());
        sideNet.position.set(gx + side*1, 1.22, s*3.66); sideNet.rotation.y = 0; roomGrp.add(sideNet);
      }
    }

    /* GRANDSTAND */
    if (f.type === 'grandstand') {
      /* Tiered seating */
      const tiers = 8;
      for (let i=0;i<tiers;i++) {
        const h = 0.5 + i*1.5;
        const w = f.side === 'north' || f.side === 'south' ? f.w : 1.5 + i*0.9;
        const d = f.side === 'north' || f.side === 'south' ? 1.5 + i*0.9 : f.d;
        const cx = f.x;
        const cz = f.z;
        let bx = cx, bz = cz, bwx = w, bdz = d;
        if (f.side === 'north') { bz = f.z + f.d/2 - d/2 - i*(f.d/tiers); bwx = f.w; bdz = f.d/tiers; }
        else if (f.side === 'south') { bz = f.z - f.d/2 + d/2 + i*(f.d/tiers); bwx = f.w; bdz = f.d/tiers; }
        else if (f.side === 'west') { bx = f.x + f.w/2 - d/2 - i*(f.w/tiers); bwx = f.w/tiers; bdz = f.d; }
        else { bx = f.x - f.w/2 + d/2 + i*(f.w/tiers); bwx = f.w/tiers; bdz = f.d; }
        const step = new THREE.Mesh(new THREE.BoxGeometry(bwx, h, bdz), M.stand());
        step.position.set(bx, h/2, bz); step.castShadow = true; step.receiveShadow = true; roomGrp.add(step);
        /* Seats on top */
        const seat = new THREE.Mesh(new THREE.BoxGeometry(bwx * 0.95, 0.15, bdz * 0.9), M.standSeat());
        seat.position.set(bx, h + 0.08, bz); roomGrp.add(seat);
        /* Accent seats in some rows */
        if (i % 3 === 1) {
          for (let k=0;k<4;k++) {
            const acc = new THREE.Mesh(new THREE.BoxGeometry(bwx * 0.05, 0.16, bdz * 0.85), M.standSeat2());
            if (f.side === 'north' || f.side === 'south')
              acc.position.set(bx - bwx/2 + bwx*0.2 + k*bwx*0.2, h + 0.09, bz);
            else acc.position.set(bx, h + 0.09, bz - bdz/2 + bdz*0.2 + k*bdz*0.2);
            roomGrp.add(acc);
          }
        }
      }
    }

    /* CORNER STAND */
    if (f.type === 'cornerStand') {
      for (let i=0;i<6;i++) {
        const h = 0.5 + i*2;
        const step = new THREE.Mesh(new THREE.BoxGeometry(6, h, 6), M.stand());
        step.position.set(f.x, h/2, f.z); step.castShadow = true; roomGrp.add(step);
      }
    }

    /* CANOPY ROOF */
    if (f.type === 'canopy') {
      const c = new THREE.Mesh(new THREE.BoxGeometry(f.w, 0.4, f.d), M.canopy());
      c.position.set(f.x, f.H, f.z); c.castShadow = true; roomGrp.add(c);
      /* Support columns */
      const cols = f.side === 'north' || f.side === 'south' ? 8 : 6;
      for (let i=0;i<cols;i++) {
        const cx = f.side === 'north' || f.side === 'south' ? f.x - f.w/2 + (i + 0.5) * (f.w/cols) : f.x;
        const cz = f.side === 'north' || f.side === 'south' ? f.z : f.z - f.d/2 + (i + 0.5) * (f.d/cols);
        const col = new THREE.Mesh(new THREE.CylinderGeometry(0.2,0.25,f.H,10), M.metal);
        col.position.set(cx, f.H/2, cz); col.castShadow = true; roomGrp.add(col);
      }
    }

    /* FLOODLIGHT TOWER */
    if (f.type === 'floodlight') {
      const pole = new THREE.Mesh(new THREE.CylinderGeometry(0.6, 1.2, f.H, 14), M.floodlight());
      pole.position.set(f.x, f.H/2, f.z); pole.castShadow = true; roomGrp.add(pole);
      /* Head with 12 lights */
      const head = new THREE.Mesh(new THREE.BoxGeometry(4, 3, 1.5), M.floodlight());
      head.position.set(f.x, f.H + 2, f.z); head.castShadow = true; roomGrp.add(head);
      for (let i=0;i<4;i++) {
        for (let j=0;j<3;j++) {
          const bulb = new THREE.Mesh(new THREE.BoxGeometry(0.8, 0.6, 0.15), M.floodlightGlow());
          bulb.position.set(f.x - 1.5 + i*1, f.H + 1 + j*0.9, f.z + 0.85);
          roomGrp.add(bulb);
        }
      }
      /* Glow light */
      const light = new THREE.PointLight(0xfff5cc, 1.2, 120, 2);
      light.position.set(f.x, f.H + 2, f.z); roomGrp.add(light);
    }

    /* SCOREBOARD */
    if (f.type === 'scoreboard') {
      const frame = new THREE.Mesh(new THREE.BoxGeometry(f.w, f.h, 0.5), M.scoreboard());
      frame.position.set(f.x, 8, f.z); frame.castShadow = true; roomGrp.add(frame);
      const screen = new THREE.Mesh(new THREE.PlaneGeometry(f.w - 0.5, f.h - 0.5), M.scoreboardScreen());
      screen.position.set(f.x, 8, f.z + 0.28); roomGrp.add(screen);
      /* Supports */
      for (const sx of [-f.w/2 + 1, f.w/2 - 1]) {
        const support = new THREE.Mesh(new THREE.CylinderGeometry(0.15,0.15,8,10), M.metal);
        support.position.set(f.x + sx, 4, f.z); roomGrp.add(support);
      }
    }

    /* TUNNEL */
    if (f.type === 'tunnel') {
      const t = new THREE.Mesh(new THREE.BoxGeometry(f.w, f.H, f.d), M.tunnel());
      t.position.set(f.x, f.H/2, f.z); t.castShadow = true; roomGrp.add(t);
      /* Opening */
      const opening = new THREE.Mesh(new THREE.PlaneGeometry(f.w - 1, f.H - 0.5),
        new THREE.MeshBasicMaterial({color:0x0a0a0a}));
      opening.position.set(f.x, f.H/2 - 0.25, f.z - f.d/2 + 0.01);
      roomGrp.add(opening);
      /* Roof */
      const roof = new THREE.Mesh(new THREE.BoxGeometry(f.w + 0.4, 0.3, f.d + 0.4), M.canopy());
      roof.position.set(f.x, f.H + 0.15, f.z); roomGrp.add(roof);
    }

    /* PRESS BOX */
    if (f.type === 'pressBox') {
      const pb = new THREE.Mesh(new THREE.BoxGeometry(f.w, f.H, f.d), M.pressBox());
      pb.position.set(f.x, 9 + f.H/2, f.z); roomGrp.add(pb);
      /* Windows */
      for (let i=0;i<4;i++) {
        const win = new THREE.Mesh(new THREE.PlaneGeometry(f.d/5, 1.2),
          new THREE.MeshBasicMaterial({color:0x60a5fa,transparent:true,opacity:0.7}));
        win.position.set(f.x - f.w/2 - 0.01, 10, f.z - f.d/2 + (i+0.5)*(f.d/4));
        win.rotation.y = -Math.PI/2; roomGrp.add(win);
      }
      /* Supports */
      for (const cz of [-f.d/2 + 1, f.d/2 - 1]) {
        const support = new THREE.Mesh(new THREE.CylinderGeometry(0.25,0.3,9,12), M.metal);
        support.position.set(f.x, 4.5, f.z + cz); roomGrp.add(support);
      }
    }
  }
}

/* ============ DEVICES ============ */
const meshById = new Map();
function buildDevices() {
  clearGroup(devGrp); meshById.clear();
  for (const d of state.devices) {
    const spec = getSpec(d.cat, d.typeId); if (!spec) continue;
    const color = BRANDS[d.brand] ? BRANDS[d.brand].color : 0x22c55e;
    const mesh = makeMesh(d.cat, d.typeId, color); if (!mesh) continue;
    mesh.position.set(d.x, spec.h, d.z);
    mesh.rotation.y = d.rot || 0;
    mesh.userData.devId = d.id;
    mesh.userData.dev = d;
    mesh.userData.spec = spec;
    devGrp.add(mesh);
    meshById.set(d.id, mesh);
  }
  updateSelectionVisuals();
}
function updateSelectionVisuals() {
  devGrp.children.forEach(m => {
    const r = m.getObjectByName('selRing');
    if (r) r.material.opacity = (state.selected === m.userData.devId) ? 0.9 : 0;
  });
}

/* ============ HEATMAP ============ */
let heatMesh = null;
function disposeHeat() {
  if (heatMesh) { heatGrp.remove(heatMesh); heatMesh.geometry.dispose(); heatMesh.material.dispose(); heatMesh = null; }
}
function buildHeatmap() {
  disposeHeat();
  if (!state.showHeat) return;
  const speakers = state.devices.filter(d =>
    d.cat === 'mainPA' || d.cat === 'delay' || d.cat === 'stands' ||
    d.cat === 'field' || d.cat === 'press' || d.cat === 'player' ||
    d.cat === 'paging' || d.cat === 'emergency'
  );
  if (!speakers.length) {
    document.getElementById('hudSpl').textContent = '—';
    document.getElementById('hudCoverage').textContent = '0%';
    return;
  }
  const SIZE = Math.max(ROOM.size[0], ROOM.size[1]) * 1.15;
  const RES = 130;
  const geo = new THREE.PlaneGeometry(SIZE, SIZE, RES, RES);
  geo.rotateX(-Math.PI/2);
  const colors = new Float32Array(geo.attributes.position.count * 3);
  geo.setAttribute('color', new THREE.BufferAttribute(colors, 3));
  heatMesh = new THREE.Mesh(geo, new THREE.MeshBasicMaterial({
    vertexColors: true, transparent: true, opacity: 0.5,
    depthWrite: false, side: THREE.DoubleSide
  }));
  heatMesh.position.y = 0.15;
  heatMesh.renderOrder = 1;
  heatGrp.add(heatMesh);
  updateHeatColors();
}
function calcSPL(x, z) {
  let tot = 0;
  for (const spk of state.devices) {
    if (spk.cat !== 'mainPA' && spk.cat !== 'delay' && spk.cat !== 'stands' &&
        spk.cat !== 'field' && spk.cat !== 'press' && spk.cat !== 'player' &&
        spk.cat !== 'paging' && spk.cat !== 'emergency') continue;
    const spec = getSpec(spk.cat, spk.typeId);
    if (!spec || !spec.power) continue;
    const power = spk.power || spec.power;
    const dx = x - spk.x, dz = z - spk.z;
    const dy = -spec.h;
    const d = Math.sqrt(dx*dx + dy*dy + dz*dz);
    if (d < 0.5) continue;
    const s1m = 88 + 10 * Math.log10(Math.max(power,1));
    let dl = 0;
    if (spec.dir) {
      const facing = spk.rot || 0;
      const tl = Math.atan2(dx, dz);
      let a = Math.abs(facing - tl);
      if (a > Math.PI) a = 2*Math.PI - a;
      dl = -11 * (1 - Math.cos(a));
    }
    const dL = -20 * Math.log10(d);
    const v = s1m + dL + dl;
    if (v < -20) continue;
    tot += Math.pow(10, v/10);
  }
  return tot > 0 ? 10 * Math.log10(tot) : 0;
}
const SPL_STOPS = [
  [50,0.05,0.10,0.45],[62,0.00,0.30,0.80],[70,0.00,0.65,0.95],
  [76,0.00,0.90,0.90],[82,0.30,0.90,0.45],[88,0.85,0.90,0.25],
  [94,1.00,0.65,0.15],[100,1.00,0.25,0.10],[115,0.85,0.05,0.15]
];
function splRGB(v) {
  const S = SPL_STOPS, N = S.length;
  if (v <= S[0][0]) return [S[0][1],S[0][2],S[0][3]];
  if (v >= S[N-1][0]) return [S[N-1][1],S[N-1][2],S[N-1][3]];
  for (let i=0;i<N-1;i++) {
    const a=S[i], b=S[i+1];
    if (v>=a[0] && v<=b[0]) {
      const t = (v-a[0])/(b[0]-a[0]);
      return [a[1]+(b[1]-a[1])*t,a[2]+(b[2]-a[2])*t,a[3]+(b[3]-a[3])*t];
    }
  }
  return [1,1,1];
}
function updateHeatColors() {
  if (!heatMesh) return;
  const pos = heatMesh.geometry.attributes.position;
  const col = heatMesh.geometry.attributes.color;
  let mx = 0, covered = 0;
  const total = pos.count;
  for (let i=0;i<total;i++) {
    const x = pos.getX(i), z = pos.getZ(i);
    const v = calcSPL(x, z);
    if (v > mx) mx = v;
    if (v >= 80) covered++;
    const c = splRGB(v);
    col.setXYZ(i, c[0], c[1], c[2]);
  }
  col.needsUpdate = true;
  document.getElementById('hudSpl').textContent = mx > 0 ? mx.toFixed(0) + ' dB' : '—';
  const covPct = total > 0 ? Math.round((covered/total)*100) : 0;
  document.getElementById('hudCoverage').textContent = covPct + '%';
  const statSpl = document.getElementById('statSpl');
  const statCov = document.getElementById('statCov');
  statSpl.classList.remove('good','warn');
  statCov.classList.remove('good','warn');
  if (mx >= 90 && mx <= 110) statSpl.classList.add('good');
  else if (mx > 0) statSpl.classList.add('warn');
  if (covPct >= 60) statCov.classList.add('good');
  else if (covPct >= 40) statCov.classList.add('warn');
}

/* ============ HISTORY ============ */
function serialize() {
  return JSON.stringify(state.devices.map(d => ({
    id:d.id, brand:d.brand, cat:d.cat, typeId:d.typeId,
    x:d.x, z:d.z, rot:d.rot, power:d.power
  })));
}
function pushHistory() {
  state.history = state.history.slice(0, state.historyIdx + 1);
  state.history.push(serialize());
  state.historyIdx = state.history.length - 1;
}
function applyHistory(json) {
  state.devices = JSON.parse(json);
  state.nextId = state.devices.length ? Math.max(...state.devices.map(d=>d.id))+1 : 1;
  buildDevices(); buildHeatmap(); updateHUD(); deselect();
}
function undo() {
  if (state.historyIdx > 0) { state.historyIdx--; applyHistory(state.history[state.historyIdx]); toast(T('to_undo')); }
}
function redo() {
  if (state.historyIdx < state.history.length - 1) { state.historyIdx++; applyHistory(state.history[state.historyIdx]); toast(T('to_redo')); }
}

/* ============ CAMERA ============ */
function updateCamera() {
  const {theta, phi, radius, target} = state.cam;
  const x = target.x + radius * Math.sin(phi) * Math.sin(theta);
  const y = target.y + radius * Math.cos(phi);
  const z = target.z + radius * Math.sin(phi) * Math.cos(theta);
  camera.position.set(x, Math.max(y, 1), z);
  camera.lookAt(target);
}
function tweenCamera(to, dur) {
  const from = {theta: state.cam.theta, phi: state.cam.phi, radius: state.cam.radius, target: state.cam.target.clone()};
  state.cam.tween = {from, to, dur, start:performance.now()};
}
function updateTween() {
  const t = state.cam.tween; if (!t) return;
  const p = Math.min(1, (performance.now() - t.start) / t.dur);
  const e = p < 0.5 ? 4*p*p*p : 1 - Math.pow(-2*p+2,3)/2;
  state.cam.theta = t.from.theta + (t.to.theta - t.from.theta) * e;
  state.cam.phi = t.from.phi + (t.to.phi - t.from.phi) * e;
  state.cam.radius = t.from.radius + (t.to.radius - t.from.radius) * e;
  state.cam.target.lerpVectors(t.from.target, t.to.target, e);
  updateCamera();
  if (p >= 1) state.cam.tween = null;
}
function setView3D(on) {
  state.view3D = on;
  const btn = document.getElementById('viewBtn');
  btn.textContent = on ? '✏️ 2D' : '🎬 3D';
  btn.classList.toggle('on', !on);
  const r = Math.max(ROOM.size[0], ROOM.size[1]) * 1.15;
  if (on) tweenCamera({theta:-0.5, phi:0.8, radius:r, target:new THREE.Vector3(0,8,0)}, 900);
  else tweenCamera({theta:0, phi:0.02, radius:r, target:new THREE.Vector3(0,0,0)}, 900);
}
function fitView() {
  const r = Math.max(ROOM.size[0], ROOM.size[1]) * 1.15;
  if (state.view3D) tweenCamera({theta:-0.5, phi:0.8, radius:r, target:new THREE.Vector3(0,8,0)}, 700);
  else tweenCamera({theta:0, phi:0.02, radius:r, target:new THREE.Vector3(0,0,0)}, 700);
}

/* ============ INTERACTION ============ */
const raycaster = new THREE.Raycaster();
const pointer = new THREE.Vector2();
const activePointers = new Map();
let isDown = false, moved = false, dragDev = null;
let dragOff = {x:0, z:0};
let startPt = {x:0, y:0};
let pinchStart = null;

function canvasPos(cx, cy) {
  const r = canvas.getBoundingClientRect();
  pointer.x = ((cx - r.left) / r.width) * 2 - 1;
  pointer.y = -((cy - r.top) / r.height) * 2 + 1;
}
function hitDevice(cx, cy) {
  canvasPos(cx, cy);
  raycaster.setFromCamera(pointer, camera);
  const hits = raycaster.intersectObjects(devGrp.children, true);
  for (const h of hits) {
    let o = h.object;
    while (o && o.userData.devId === undefined) o = o.parent;
    if (o) return o;
  }
  return null;
}
const floorPlane = new THREE.Plane(new THREE.Vector3(0,1,0), 0);
function floorPoint(cx, cy) {
  canvasPos(cx, cy);
  raycaster.setFromCamera(pointer, camera);
  const p = new THREE.Vector3();
  return raycaster.ray.intersectPlane(floorPlane, p) ? p : null;
}

canvas.addEventListener('pointerdown', e => {
  activePointers.set(e.pointerId, {x:e.clientX, y:e.clientY});
  if (activePointers.size === 1) {
    startPt = {x:e.clientX, y:e.clientY};
    isDown = true; moved = false; dragDev = null;
    const hit = hitDevice(e.clientX, e.clientY);
    if (hit) {
      dragDev = hit;
      const fp = floorPoint(e.clientX, e.clientY);
      if (fp) { dragOff.x = hit.userData.dev.x - fp.x; dragOff.z = hit.userData.dev.z - fp.z; }
    }
  } else if (activePointers.size === 2) {
    dragDev = null; isDown = false; moved = true;
    const pts = [...activePointers.values()];
    pinchStart = {dist: Math.hypot(pts[0].x-pts[1].x, pts[0].y-pts[1].y) || 1, radius: state.cam.radius};
  }
}, {passive:true});

canvas.addEventListener('pointermove', e => {
  if (!activePointers.has(e.pointerId)) return;
  const prev = activePointers.get(e.pointerId);
  activePointers.set(e.pointerId, {x:e.clientX, y:e.clientY});
  if (activePointers.size === 2 && pinchStart) {
    const pts = [...activePointers.values()];
    const d = Math.hypot(pts[0].x-pts[1].x, pts[0].y-pts[1].y) || 1;
    state.cam.radius = Math.max(20, Math.min(700, pinchStart.radius * (pinchStart.dist/d)));
    state.cam.tween = null; updateCamera(); return;
  }
  if (!isDown) return;
  const dx = e.clientX - prev.x;
  const dy = e.clientY - prev.y;
  if (Math.abs(e.clientX-startPt.x) + Math.abs(e.clientY-startPt.y) > 6) moved = true;
  if (dragDev && moved) {
    const fp = floorPoint(e.clientX, e.clientY);
    if (fp) {
      const d = dragDev.userData.dev;
      d.x = Math.round((fp.x + dragOff.x)*10)/10;
      d.z = Math.round((fp.z + dragOff.z)*10)/10;
      dragDev.position.set(d.x, dragDev.userData.spec.h, d.z);
      if (state.showHeat) updateHeatColors();
      updateInfo();
    }
  } else if (!dragDev && moved && !state.presentation) {
    if (state.view3D) {
      state.cam.tween = null;
      state.cam.theta -= dx * 0.008;
      state.cam.phi = Math.max(0.12, Math.min(1.52, state.cam.phi + dy * 0.008));
      updateCamera();
    } else {
      state.cam.tween = null;
      const ps = state.cam.radius * 0.0018;
      state.cam.target.x -= (dx*Math.cos(state.cam.theta) - dy*Math.sin(state.cam.theta)) * ps;
      state.cam.target.z -= (dx*Math.sin(state.cam.theta) + dy*Math.cos(state.cam.theta)) * ps;
      updateCamera();
    }
  }
}, {passive:true});

function endPointer(e) {
  activePointers.delete(e.pointerId);
  if (activePointers.size === 0) {
    if (isDown && !moved && !state.presentation) {
      const hit = hitDevice(e.clientX, e.clientY);
      if (hit) select(hit.userData.devId);
      else if (state.selected !== null) deselect();
      else {
        const fp = floorPoint(e.clientX, e.clientY);
        if (fp) { placeDevice(fp.x, fp.z); pushHistory(); }
      }
    }
    isDown = false; dragDev = null; moved = false; pinchStart = null;
  } else {
    pinchStart = null; isDown = false; dragDev = null; moved = true;
  }
}
canvas.addEventListener('pointerup', endPointer, {passive:true});
canvas.addEventListener('pointercancel', endPointer, {passive:true});
canvas.addEventListener('wheel', e => {
  e.preventDefault();
  state.cam.tween = null;
  const factor = e.deltaY > 0 ? 1.1 : 0.9;
  state.cam.radius = Math.max(20, Math.min(700, state.cam.radius * factor));
  updateCamera();
}, {passive:false});

/* ============ ACTIONS ============ */
function placeDevice(x, z) {
  const spec = getSpec(state.curCat, state.curType); if (!spec) return;
  const d = {id: state.nextId++, brand: state.curBrand, cat: state.curCat, typeId: state.curType,
    x: Math.round(x*10)/10, z: Math.round(z*10)/10, rot: 0, power: spec.power};
  state.devices.push(d);
  buildDevices();
  if (state.showHeat) buildHeatmap();
  updateHUD();
  toast(spec.emoji + ' ' + devName(spec));
}
function select(id) {
  state.selected = id;
  updateSelectionVisuals(); updateInfo();
  document.getElementById('info').classList.add('on');
}
function deselect() {
  state.selected = null;
  updateSelectionVisuals();
  document.getElementById('info').classList.remove('on');
}
function deleteSelected() {
  if (state.selected === null) return;
  state.devices = state.devices.filter(d => d.id !== state.selected);
  state.selected = null;
  document.getElementById('info').classList.remove('on');
  buildDevices(); buildHeatmap(); updateHUD(); pushHistory();
  toast(T('to_deleted'));
}
function updateInfo() {
  if (state.selected === null) return;
  const d = state.devices.find(x => x.id === state.selected); if (!d) return;
  const spec = getSpec(d.cat, d.typeId); if (!spec) return;
  document.getElementById('infName').textContent = spec.emoji + ' ' + devName(spec);
  document.getElementById('infBrand').textContent = brandName(d.brand);
  document.getElementById('infType').textContent = catName(d.cat);
  document.getElementById('infPower').textContent = spec.power > 0 ? (d.power||spec.power) + ' W' : '—';
  document.getElementById('infH').textContent = spec.h.toFixed(1) + (LANG==='ar'?' م':' m');
  document.getElementById('infPos').textContent = d.x.toFixed(1) + ', ' + d.z.toFixed(1);
  const pw = document.getElementById('powerSlider');
  pw.value = d.power || spec.power;
  document.getElementById('powerVal').textContent = (d.power||spec.power) + 'W';
  document.getElementById('powerWrap').style.display = spec.power > 0 ? 'flex' : 'none';
  const rs = document.getElementById('rotSlider');
  const deg = Math.round((d.rot||0) * 180 / Math.PI);
  rs.value = deg;
  document.getElementById('rotVal').textContent = deg + '°';
  document.getElementById('rotWrap').style.display = spec.dir ? 'flex' : 'none';
  document.getElementById('roomWInput').value = ROOM.size[0];
  document.getElementById('roomDInput').value = ROOM.size[1];
}

/* ============ UI ============ */
function buildCats() {
  const el = document.getElementById('cats'); el.innerHTML = '';
  for (const key in CATS) {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'cat' + (key === state.curCat ? ' on' : '');
    b.dataset.cat = key;
    b.textContent = CATS[key].emoji + ' ' + catName(key);
    b.onclick = () => selectCat(key);
    el.appendChild(b);
  }
}
function buildBrands() {
  const el = document.getElementById('brands'); el.innerHTML = '';
  for (const key in BRANDS) {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'brand' + (key === state.curBrand ? ' on' : '');
    b.dataset.brand = key;
    b.textContent = brandName(key);
    b.onclick = () => selectBrand(key);
    el.appendChild(b);
  }
}
function buildTypes() {
  const el = document.getElementById('types'); el.innerHTML = '';
  for (const d of CATS[state.curCat].devices) {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'type' + (d[0] === state.curType ? ' on' : '');
    b.dataset.typeId = d[0];
    b.innerHTML = '<span class="em">' + d[2] + '</span><span class="nm">' + T(d[1]) + '</span>';
    b.onclick = () => selectType(d[0]);
    el.appendChild(b);
  }
}
function selectCat(key) {
  state.curCat = key;
  state.curType = CATS[key].devices[0][0];
  document.querySelectorAll('.cat').forEach(b => b.classList.toggle('on', b.dataset.cat === key));
  buildTypes();
}
function selectBrand(key) {
  state.curBrand = key;
  document.querySelectorAll('.brand').forEach(b => b.classList.toggle('on', b.dataset.brand === key));
}
function selectType(id) {
  state.curType = id;
  document.querySelectorAll('.type').forEach(b => b.classList.toggle('on', b.dataset.typeId === id));
}
function updateHUD() { document.getElementById('hudCount').textContent = state.devices.length; }
let toastTO;
function toast(m) {
  const el = document.getElementById('toast');
  el.textContent = m; el.classList.add('on');
  clearTimeout(toastTO);
  toastTO = setTimeout(() => el.classList.remove('on'), 1700);
}
function loadInitialDevices() {
  state.devices = []; state.nextId = 1; state.selected = null;
  for (const item of ROOM.devices) {
    const [brand, cat, typeId, x, z, rot] = item;
    const spec = getSpec(cat, typeId); if (!spec) continue;
    state.devices.push({id: state.nextId++, brand, cat, typeId, x, z, rot: rot || 0, power: spec.power});
  }
  buildRoom(); buildDevices(); buildHeatmap(); updateHUD(); deselect();
  state.history = [serialize()]; state.historyIdx = 0;
}

/* ============ REPORT ============ */
function generateReport() {
  const totalPower = state.devices.reduce((a,d) => {
    const s = getSpec(d.cat, d.typeId);
    return a + (s && s.power ? (d.power || s.power) : 0);
  }, 0);
  const counts = {};
  const zoneCounts = {mainPA:0, delay:0, stands:0, field:0, press:0, player:0, referee:0, paging:0, emergency:0};
  state.devices.forEach(d => {
    const spec = getSpec(d.cat, d.typeId); if (!spec) return;
    const key = brandName(d.brand) + ' · ' + devName(spec);
    counts[key] = (counts[key] || 0) + 1;
    if (zoneCounts[d.cat] !== undefined) zoneCounts[d.cat]++;
  });
  let rows = '';
  const entries = Object.entries(counts);
  if (entries.length) {
    for (const [name, qty] of entries) rows += `<tr><td>${name}</td><td>${qty}</td></tr>`;
  } else {
    rows = `<tr><td colspan="2" style="text-align:center;color:#888">${T('rep_empty')}</td></tr>`;
  }
  const splVal = document.getElementById('hudSpl').textContent;
  const covVal = document.getElementById('hudCoverage').textContent;

  const rt60Display = 'N/A (Outdoor)';
  const reverbQuality = '🏟️ ' + (LANG==='ar'?'حقل مفتوح (لا صدى)':'Open field (no reverb)');

  const capacity = 45000;
  const hasMainPA = state.devices.filter(d => d.cat === 'mainPA').length >= 4;
  const hasDelay = state.devices.filter(d => d.cat === 'delay').length >= 4;
  const hasReferee = state.devices.filter(d => d.cat === 'referee').length >= 4;
  const hasPress = state.devices.filter(d => d.cat === 'press').length >= 3;
  const hasPaging = state.devices.some(d => d.cat === 'paging') &&
                    state.devices.some(d => d.cat === 'control' && d.typeId === 'paging_ctrl');
  const hasEmergency = state.devices.some(d => d.cat === 'emergency') &&
                       state.devices.some(d => d.cat === 'control' && d.typeId === 'emg_ctrl');

  document.getElementById('reportModalBody').innerHTML = `
    <div class="report-section">
      <h4>📍 ${T('rep_env_info')}</h4>
      <div class="row"><span>${T('rep_env_type')}</span><span>${ROOM.name[LANG]}</span></div>
      <div class="row"><span>${T('rep_dim')}</span><span>${ROOM.size[0]}m × ${ROOM.size[1]}m (Outdoor)</span></div>
      <div class="row"><span>${T('rep_field')}</span><span>100m × 64m (FIFA)</span></div>
      <div class="row"><span>${T('rep_capacity')}</span><span>~${capacity.toLocaleString()} ${LANG==='ar'?'متفرج':'spectators'}</span></div>
      <div class="row"><span>${T('rep_zones')}</span><span>${[zoneCounts.mainPA,zoneCounts.delay,zoneCounts.stands,zoneCounts.field,zoneCounts.press,zoneCounts.player,zoneCounts.referee].filter(c=>c>0).length} ${LANG==='ar'?'منطقة':'zones'}</span></div>
      <div class="row"><span>${T('rep_total_dev')}</span><span>${state.devices.length}</span></div>
      <div class="row"><span>${T('rep_total_power')}</span><span>${(totalPower/1000).toFixed(2)} kW</span></div>
      <div class="row"><span>${T('rep_date')}</span><span>${new Date().toLocaleString(LANG==='ar'?'ar-EG':'en-US')}</span></div>
    </div>
    <div class="report-section">
      <h4>🔊 ${T('rep_equip')}</h4>
      <table class="report-table">
        <thead><tr><th>${T('rep_device')}</th><th style="width:80px;text-align:center">${T('rep_qty')}</th></tr></thead>
        <tbody>${rows}</tbody>
      </table>
    </div>
    <div class="report-section">
      <h4>📊 ${T('rep_analysis')}</h4>
      <div class="row"><span>${T('rep_max_spl')}</span><span>${splVal}</span></div>
      <div class="row"><span>${T('rep_coverage')}</span><span>${covVal}</span></div>
      <div class="row"><span>${T('rep_target')}</span><span>${T('rep_pa_target')}</span></div>
      <div class="row"><span>${T('rep_rt')}</span><span>${rt60Display}</span></div>
      <div class="row"><span>${T('rep_reverb')}</span><span>${reverbQuality}</span></div>
      <div class="row"><span>🎚️ ${T('rep_pa')}</span><span style="color:${hasMainPA?'#22c55e':'#fbbf24'}">${hasMainPA ? (LANG==='ar'?'نشط (8 مصفوفات)':'Active (8 arrays)') : (LANG==='ar'?'غير مُهيَّأ':'Not configured')}</span></div>
      <div class="row"><span>📡 ${T('cat_delay')}</span><span style="color:${hasDelay?'#22c55e':'#fbbf24'}">${hasDelay ? (LANG==='ar'?'مفعّل (4 أبراج)':'Active (4 towers)') : (LANG==='ar'?'غير مُهيَّأ':'Not configured')}</span></div>
      <div class="row"><span>🎽 ${T('rep_referee')}</span><span style="color:${hasReferee?'#22c55e':'#fbbf24'}">${hasReferee ? (LANG==='ar'?'نشط':'Active') : (LANG==='ar'?'غير مُهيَّأ':'Not configured')}</span></div>
      <div class="row"><span>📺 ${T('cat_press')}</span><span style="color:${hasPress?'#22c55e':'#fbbf24'}">${hasPress ? (LANG==='ar'?'نشط':'Active') : (LANG==='ar'?'غير مُهيَّأ':'Not configured')}</span></div>
      <div class="row"><span>${T('rep_paging')}</span><span style="color:${hasPaging?'#22c55e':'#fbbf24'}">${hasPaging ? (LANG==='ar'?'نشط':'Active') : (LANG==='ar'?'غير مُهيَّأ':'Not configured')}</span></div>
      <div class="row"><span>${T('rep_emergency')}</span><span style="color:${hasEmergency?'#22c55e':'#fbbf24'}">${hasEmergency ? (LANG==='ar'?'مطابق (نشط)':'Compliant (Active)') : (LANG==='ar'?'غير مُهيَّأ':'Not configured')}</span></div>
      <div class="row"><span>${T('rep_fifa')}</span><span style="color:#22c55e">${LANG==='ar'?'مطابق':'Compliant'}</span></div>
      <div class="row"><span>${T('rep_ada')}</span><span style="color:#22c55e">${LANG==='ar'?'مطابق':'Compliant'}</span></div>
      <div class="row"><span>${T('rep_status')}</span><span style="color:#22c55e">${T('rep_status_good')}</span></div>
    </div>
  `;
  document.getElementById('reportModal').classList.add('on');
}

/* ============ EVENTS ============ */
document.getElementById('langBtn').onclick = () => {
  LANG = LANG === 'ar' ? 'en' : 'ar';
  localStorage.setItem('auralis_lang', LANG);
  applyLang();
  buildCats(); buildBrands(); buildTypes();
  if (state.selected !== null) updateInfo();
  toast(LANG === 'ar' ? '🌐 العربية' : '🌐 English');
};
document.getElementById('reportBtn').onclick = generateReport;
document.getElementById('closeModalBtn').onclick = () => document.getElementById('reportModal').classList.remove('on');
document.getElementById('closeModalBtn2').onclick = () => document.getElementById('reportModal').classList.remove('on');
document.getElementById('printReportBtn').onclick = () => window.print();

document.getElementById('saveBtn').onclick = () => {
  const data = JSON.stringify({app:'AURALIS', version:1, room:'stadium-field',
    devices: state.devices.map(d => ({id:d.id, brand:d.brand, cat:d.cat, typeId:d.typeId, x:d.x, z:d.z, rot:d.rot, power:d.power}))
  }, null, 2);
  const blob = new Blob([data], {type:'application/json'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'auralis-stadium-field-' + Date.now() + '.json';
  document.body.appendChild(a); a.click();
  setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 1000);
  toast(T('to_saved'));
};
document.getElementById('loadBtn').onclick = () => document.getElementById('fileInput').click();
document.getElementById('fileInput').onchange = e => {
  const file = e.target.files[0]; if (!file) return;
  const reader = new FileReader();
  reader.onload = ev => {
    try {
      const data = JSON.parse(ev.target.result);
      state.devices = (data.devices||[]).map(d => ({
        id: d.id,
        brand: BRANDS[d.brand] ? d.brand : 'jbl',
        cat: CATS[d.cat] ? d.cat : 'mainPA',
        typeId: d.typeId,
        x:+d.x||0, z:+d.z||0, rot:+d.rot||0, power:+d.power||0
      })).filter(d => getSpec(d.cat, d.typeId));
      state.nextId = state.devices.length ? Math.max(...state.devices.map(d=>d.id))+1 : 1;
      buildDevices(); buildHeatmap(); updateHUD(); fitView();
      state.history = [serialize()]; state.historyIdx = 0;
      toast(T('to_loaded'));
    } catch(err) { alert(T('to_invalid')); }
  };
  reader.readAsText(file);
  e.target.value = '';
};

document.getElementById('viewBtn').onclick = () => setView3D(!state.view3D);
document.getElementById('shotBtn').onclick = () => {
  renderer.render(scene, camera);
  const a = document.createElement('a');
  a.href = canvas.toDataURL('image/png');
  a.download = 'auralis-stadium-field-' + Date.now() + '.png';
  document.body.appendChild(a); a.click(); a.remove();
  toast(T('to_shot'));
};
document.getElementById('presBtn').onclick = togglePres;
document.getElementById('presToggle').onclick = togglePres;
document.getElementById('exitPres').onclick = togglePres;
function togglePres() {
  state.presentation = !state.presentation;
  document.getElementById('hd').classList.toggle('hide', state.presentation);
  document.getElementById('tools').classList.toggle('hide', state.presentation);
  document.getElementById('picker').classList.toggle('hide', state.presentation);
  document.getElementById('hud').style.opacity = state.presentation ? '0' : '1';
  document.getElementById('info').classList.remove('on');
  document.getElementById('exitPres').classList.toggle('on', state.presentation);
  toast(state.presentation ? T('to_pres_on') : T('to_pres_off'));
}
document.getElementById('heatBtn').onclick = function() {
  state.showHeat = !state.showHeat;
  this.classList.toggle('on', state.showHeat);
  buildHeatmap();
  toast(state.showHeat ? T('to_heat_on') : T('to_heat_off'));
};
document.getElementById('fitBtn').onclick = fitView;
document.getElementById('gridBtn').onclick = function() {
  state.showGrid = !state.showGrid;
  this.classList.toggle('on', state.showGrid);
  grid.visible = state.showGrid;
};
document.getElementById('clearBtn').onclick = () => {
  if (!confirm(T('to_confirm_clear'))) return;
  state.devices = []; state.selected = null;
  document.getElementById('info').classList.remove('on');
  buildDevices(); buildHeatmap(); updateHUD(); pushHistory();
  toast(T('to_cleared'));
};
document.getElementById('delBtn').onclick = deleteSelected;
document.getElementById('powerSlider').oninput = e => {
  if (state.selected === null) return;
  const d = state.devices.find(x => x.id === state.selected); if (!d) return;
  d.power = parseInt(e.target.value,10) || 0;
  document.getElementById('powerVal').textContent = d.power + 'W';
  document.getElementById('infPower').textContent = d.power + ' W';
  if (state.showHeat) updateHeatColors();
};
document.getElementById('powerSlider').onchange = () => pushHistory();
document.getElementById('rotSlider').oninput = e => {
  if (state.selected === null) return;
  const d = state.devices.find(x => x.id === state.selected); if (!d) return;
  d.rot = parseInt(e.target.value,10) * Math.PI / 180;
  const m = meshById.get(d.id);
  if (m) m.rotation.y = d.rot;
  document.getElementById('rotVal').textContent = e.target.value + '°';
  if (state.showHeat) updateHeatColors();
};
document.getElementById('rotSlider').onchange = () => pushHistory();
document.getElementById('roomWInput').onchange = e => {
  const v = Math.max(60, Math.min(300, parseFloat(e.target.value) || 130));
  ROOM.size[0] = v; e.target.value = v;
  buildRoom(); buildHeatmap();
};
document.getElementById('roomDInput').onchange = e => {
  const v = Math.max(60, Math.min(300, parseFloat(e.target.value) || 100));
  ROOM.size[1] = v; e.target.value = v;
  buildRoom(); buildHeatmap();
};
document.addEventListener('keydown', e => {
  const tag = (e.target.tagName || '').toUpperCase();
  if (tag === 'INPUT' || tag === 'SELECT' || tag === 'TEXTAREA') return;
  if ((e.ctrlKey||e.metaKey) && e.key.toLowerCase() === 'z') { e.preventDefault(); undo(); }
  else if ((e.ctrlKey||e.metaKey) && e.key.toLowerCase() === 'y') { e.preventDefault(); redo(); }
  else if (e.key === 'Delete' || e.key === 'Backspace') { e.preventDefault(); deleteSelected(); }
  else if (e.key === 'Escape') { deselect(); document.getElementById('reportModal').classList.remove('on'); }
  else if (e.key === 'Tab') { e.preventDefault(); setView3D(!state.view3D); }
});

/* ============ RESIZE ============ */
function onResize() {
  const w = window.innerWidth, h = window.innerHeight;
  camera.aspect = w / h;
  camera.updateProjectionMatrix();
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(w, h, false);
}
window.addEventListener('resize', onResize);
window.addEventListener('orientationchange', () => setTimeout(onResize, 250));

/* ============ LOOP & INIT ============ */
function animate() {
  requestAnimationFrame(animate);
  updateTween();
  const t = performance.now() * 0.003;
  devGrp.children.forEach(m => {
    const r = m.getObjectByName('selRing');
    if (r && r.material.opacity > 0) r.scale.setScalar(1 + Math.sin(t) * 0.08);
  });
  renderer.render(scene, camera);
}

function init() {
  applyLang();
  buildCats(); buildBrands(); buildTypes();
  loadInitialDevices();
  onResize();
  animate();
  setTimeout(() => document.getElementById('loader').classList.add('off'), 600);
  console.log('%c✅ AURALIS · Stadium Field ready · PA & Commentary',
    'color:#22c55e;font-weight:bold;font-size:14px');
}

init();
</script>
