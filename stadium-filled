let LANG = localStorage.getItem('auralis_lang') || 'ar';
const T = k => I18N[LANG][k] || k;

function applyLang() {
  document.documentElement.lang = LANG;
  document.documentElement.dir = LANG === 'ar' ? 'rtl' : 'ltr';
  document.body.style.fontFamily = LANG === 'ar'
    ? "'Cairo','Inter',sans-serif" : "'Inter','Cairo',sans-serif";
  document.querySelectorAll('[data-i18n]').forEach(el => {
    const k = el.dataset.i18n; if (I18N[LANG][k]) el.textContent = I18N[LANG][k];
  });
  document.querySelectorAll('[data-i18n-title]').forEach(el => {
    const k = el.dataset.i18nTitle; if (I18N[LANG][k]) el.title = I18N[LANG][k];
  });
  document.getElementById('langLabel').textContent = LANG === 'ar' ? 'EN' : 'ع';
  document.getElementById('loaderTxt').textContent = T('loader');
  document.getElementById('roomLabel').textContent = T('room_label');
  document.getElementById('presToggle').textContent = T('pres_start');
  document.title = LANG === 'ar' ? '🏟️ AURALIS · ملعب رياضي' : '🏟️ AURALIS · Stadium Field';
}

